{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bishwas54-com-np",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "routes": [
    { "pattern": "bishwas54.com.np", "custom_domain": true },
    { "pattern": "www.bishwas54.com.np", "custom_domain": true },
  ],
}
