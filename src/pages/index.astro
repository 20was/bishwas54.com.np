---
const title = 'Bishwas Adhikari';
const description =
  'Beginner-friendly notes and tutorials. I learn things and write them down so you can learn them too.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <main>
      <h1>Bishwas Adhikari</h1>
      <p>{description}</p>
      <p>
        This site is being built in the open. First tutorials are on the way.
      </p>
    </main>
  </body>
</html>
