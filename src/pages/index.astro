---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const description =
  'Beginner-friendly notes and tutorials. I learn things and write them down so you can learn them too.';

const tutorials = (
  await getCollection(
    'tutorials',
    ({ data }) => !data.draft || import.meta.env.DEV,
  )
).sort(
  (a, b) => b.data.datePublished.getTime() - a.data.datePublished.getTime(),
);
const notes = (
  await getCollection('notes', ({ data }) => !data.draft || import.meta.env.DEV)
).sort(
  (a, b) => b.data.datePublished.getTime() - a.data.datePublished.getTime(),
);

/* A series shows as ONE card (dated by its newest lesson, linking to its
 * landing page) so the home list stays a mix of works, not a flood of
 * same-day parts. Standalone tutorials and notes list individually. */
const bySeries = new Map<string, typeof tutorials>();
const standaloneTutorials: typeof tutorials = [];
for (const t of tutorials) {
  const segment = t.id.includes('/') ? t.id.split('/')[0]! : undefined;
  if (segment) bySeries.set(segment, [...(bySeries.get(segment) ?? []), t]);
  else standaloneTutorials.push(t);
}

const seriesCards = [...bySeries.entries()].map(([segment, lessons]) => {
  const parts = lessons.sort(
    (a, b) => (a.data.series?.order ?? 0) - (b.data.series?.order ?? 0),
  );
  const latest = [...parts].sort(
    (a, b) =>
      (b.data.dateUpdated ?? b.data.datePublished).getTime() -
      (a.data.dateUpdated ?? a.data.datePublished).getTime(),
  )[0]!;
  const name = parts[0]!.data.series?.name ?? segment;
  return {
    title: name,
    description: `${parts.length}-part series, in order. Latest: ${latest.data.title}.`,
    date: latest.data.dateUpdated ?? latest.data.datePublished,
    href: `/tutorials/${segment}/`,
    kind: `Series · ${parts.length} parts`,
  };
});

const recent = [
  ...seriesCards,
  ...standaloneTutorials.map((e) => ({
    title: e.data.title,
    description: e.data.description,
    date: e.data.datePublished,
    href: `/tutorials/${e.id}/`,
    kind: 'Tutorial',
  })),
  ...notes.map((e) => ({
    title: e.data.title,
    description: e.data.description,
    date: e.data.datePublished,
    href: `/notes/${e.id}/`,
    kind: 'Note',
  })),
]
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 6);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
---

<Base title="Bishwas Adhikari" description={description}>
  <div class="home">
    <h1>I learn things and write them down so you can learn them too.</h1>
    <p class="intro">
      I'm Bishwas — a software and platform engineer. This is my public
      notebook: beginner-friendly tutorials and short notes on whatever I'm
      learning, technical or not.
    </p>

    <section aria-labelledby="recent">
      <h2 id="recent" class="meta">Recent writing</h2>
      <ul class="posts">
        {
          recent.map((post) => (
            <li>
              <p class="meta kind">
                {post.kind} ·{' '}
                <time datetime={post.date.toISOString().slice(0, 10)}>
                  {fmt(post.date)}
                </time>
              </p>
              <a href={post.href}>{post.title}</a>
              <p class="description">{post.description}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

<style>
  .home {
    max-width: var(--measure);
  }

  h1 {
    font-size: var(--step-3);
    font-weight: 700;
  }

  .intro {
    margin-top: var(--space-4);
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--text-soft);
    text-wrap: pretty;
  }

  section {
    margin-top: var(--space-6);
  }

  .posts {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
  }

  .posts li + li {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }

  .posts a {
    font-size: var(--step-1);
    font-weight: 650;
    text-decoration: none;
  }

  .posts a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .description {
    margin-top: var(--space-1);
    color: var(--text-soft);
  }

  .kind {
    margin-bottom: var(--space-1);
  }
</style>
