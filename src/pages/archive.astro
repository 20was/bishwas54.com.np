---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const tutorials = await getCollection('tutorials', ({ data }) => !data.draft);
const notes = await getCollection('notes', ({ data }) => !data.draft);

const posts = [
  ...tutorials.map((e) => ({
    title: e.data.title,
    date: e.data.datePublished,
    href: `/tutorials/${e.id}/`,
    kind: 'Tutorial',
  })),
  ...notes.map((e) => ({
    title: e.data.title,
    date: e.data.datePublished,
    href: `/notes/${e.id}/`,
    kind: 'Note',
  })),
].sort((a, b) => b.date.getTime() - a.date.getTime());

const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.date.getFullYear();
  byYear.set(year, [...(byYear.get(year) ?? []), post]);
}

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
---

<Base
  title="Archive — Bishwas Adhikari"
  description="Everything ever published here, by year."
>
  <div class="archive">
    <h1>Archive</h1>
    <p class="lede">Everything, newest first.</p>
    {
      [...byYear.entries()].map(([year, yearPosts]) => (
        <section aria-labelledby={`y${year}`}>
          <h2 id={`y${year}`}>{year}</h2>
          <ul>
            {yearPosts.map((post) => (
              <li>
                <time
                  class="meta"
                  datetime={post.date.toISOString().slice(0, 10)}
                >
                  {fmt(post.date)}
                </time>
                <a href={post.href}>{post.title}</a>
                <span class="meta kind">{post.kind}</span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .archive {
    max-width: var(--measure);
  }

  h1 {
    font-size: var(--step-3);
  }

  .lede {
    margin-top: var(--space-3);
    font-size: var(--step-1);
    color: var(--text-soft);
  }

  section {
    margin-top: var(--space-5);
  }

  h2 {
    font-size: var(--step-2);
    border-bottom: 1px solid var(--line);
    padding-bottom: var(--space-2);
  }

  ul {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
  }

  li {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-2) 0;
  }

  li time {
    min-width: 4.5rem;
  }

  li a {
    text-decoration: none;
    font-weight: 500;
  }

  li a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .kind {
    margin-left: auto;
  }
</style>
