---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { articleJsonLd, breadcrumbJsonLd } from '../../lib/jsonld';

export async function getStaticPaths() {
  const notes = await getCollection(
    'notes',
    ({ data }) => !data.draft || import.meta.env.DEV,
  );
  return notes.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const path = `/notes/${entry.id}/`;
const ogImage = `/og/notes/${entry.id}.png`;
const jsonLd = [
  articleJsonLd({
    title: entry.data.title,
    description: entry.data.description,
    path,
    datePublished: entry.data.datePublished,
    dateUpdated: entry.data.dateUpdated,
    tags: entry.data.tags,
    image: ogImage,
  }),
  breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Notes', path: '/notes/' },
    { name: entry.data.title, path },
  ]),
];
---

<Article
  title={entry.data.title}
  description={entry.data.description}
  datePublished={entry.data.datePublished}
  dateUpdated={entry.data.dateUpdated}
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  <Content />
</Article>
