---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found — Bishwas Adhikari"
  description="That page doesn't exist."
  noindex
>
  <div class="lost">
    <h1>404 — nothing here</h1>
    <p>
      That page doesn't exist (or moved). Try
      <a href="/search/">searching for it</a>, or head back to the
      <a href="/">home page</a>.
    </p>
  </div>
</Base>

<style>
  .lost {
    max-width: var(--measure);
  }

  h1 {
    font-size: var(--step-3);
  }

  p {
    margin-top: var(--space-3);
    font-size: var(--step-1);
    color: var(--text-soft);
  }
</style>
