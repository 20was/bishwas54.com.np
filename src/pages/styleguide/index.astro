---
import Base from '../../layouts/Base.astro';
---

<Base
  title="Styleguide"
  description="Internal design-system reference: themes, type, and components."
  noindex
>
  <div class="guide">
    <h1>Styleguide</h1>
    <p class="lede">
      The site's visual system: Literata for reading, spruce as the accent,
      three themes (header, top right). Internal reference — not indexed.
    </p>

    <section aria-labelledby="type">
      <h2 id="type">Type specimen</h2>
      <p class="specimen-heading">
        The quick brown fox jumps over the lazy dog
      </p>
      <p>
        Regular body text at reading size. Kubernetes is a system that keeps
        your applications running the way you told it to — think of it as a very
        stubborn assistant that restarts anything that crashes.
        <em>Italics carry emphasis</em>, <strong>bold carries weight</strong>,
        and <a href="#type">links look like this</a>. Inline code such as
        <code>kubectl get pods</code> sits inside prose without shouting.
      </p>
      <pre><code>$ kubectl get pods
NAME        READY   STATUS    RESTARTS
web-7d4b9   1/1     Running   0</code></pre>
      <p class="meta">Metadata voice · 12 min read · updated Aug 2026</p>
    </section>

    <section aria-labelledby="article-demo">
      <h2 id="article-demo">Article layout</h2>
      <p>
        The notebook-margin layout with real prose:
        <a href="/styleguide/article/">sample article →</a>
      </p>
    </section>
  </div>
</Base>

<style>
  .guide {
    max-width: var(--measure);
  }

  h1 {
    font-size: var(--step-3);
  }

  .lede {
    margin-top: var(--space-3);
    font-size: var(--step-1);
    color: var(--text-soft);
    line-height: 1.5;
  }

  section {
    margin-top: var(--space-5);
  }

  h2 {
    font-size: var(--step-2);
    border-top: 1px solid var(--line);
    padding-top: var(--space-4);
  }

  section p,
  section pre {
    margin-top: var(--space-3);
  }

  .specimen-heading {
    font-size: var(--step-2);
    font-weight: 650;
    line-height: 1.2;
  }
</style>
