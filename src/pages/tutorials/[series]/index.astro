---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { readingMinutes } from '../../../lib/reading-time';
import { breadcrumbJsonLd } from '../../../lib/jsonld';

/** Series landing page: /tutorials/<series-slug>/ lists every published
 *  lesson of the series in part order. A series lesson's id is
 *  '<series-slug>/<slug>' (nested by the content sync); standalone posts
 *  have flat ids and never get a landing page. */
export async function getStaticPaths() {
  const tutorials = await getCollection(
    'tutorials',
    ({ data }) => !data.draft || import.meta.env.DEV,
  );
  const bySegment = new Map<string, typeof tutorials>();
  for (const t of tutorials) {
    const segment = t.id.includes('/') ? t.id.split('/')[0] : undefined;
    if (segment) bySegment.set(segment, [...(bySegment.get(segment) ?? []), t]);
  }
  return [...bySegment.entries()].map(([series, lessons]) => ({
    params: { series },
    props: {
      lessons: lessons.sort(
        (a, b) => (a.data.series?.order ?? 0) - (b.data.series?.order ?? 0),
      ),
    },
  }));
}

const { series } = Astro.params;
const { lessons } = Astro.props;
const name = lessons[0]?.data.series?.name ?? series;
const totalMinutes = lessons.reduce(
  (sum, l) => sum + readingMinutes(l.body ?? ''),
  0,
);
const path = `/tutorials/${series}/`;
const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Tutorials', path: '/tutorials/' },
    { name, path },
  ]),
];

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
---

<Base
  title={`${name} — Bishwas Adhikari`}
  description={`${name}: a ${lessons.length}-part series, in order, written for beginners.`}
  jsonLd={jsonLd}
>
  <div class="listing">
    <p class="meta kicker">Series</p>
    <h1>{name}</h1>
    <p class="lede">
      {lessons.length} part{lessons.length > 1 ? 's' : ''} · about {
        totalMinutes
      }
      min total. Written in order — start at part 1.
    </p>
    <ol class="lessons">
      {
        lessons.map((l) => (
          <li>
            <p class="meta">Part {l.data.series?.order}</p>
            <a href={`/tutorials/${l.id}/`}>{l.data.title}</a>
            <p class="description">{l.data.description}</p>
            <p class="meta">
              <time datetime={l.data.datePublished.toISOString().slice(0, 10)}>
                {fmt(l.data.datePublished)}
              </time>
              {' · '}
              {readingMinutes(l.body ?? '')} min · {l.data.level}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</Base>

<style>
  .listing {
    max-width: var(--measure);
  }

  .kicker {
    color: var(--accent);
  }

  h1 {
    font-size: var(--step-3);
    margin-top: var(--space-1);
  }

  .lede {
    margin-top: var(--space-3);
    font-size: var(--step-1);
    color: var(--text-soft);
    line-height: 1.5;
  }

  .lessons {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
  }

  .lessons li {
    padding: var(--space-4) 0;
    border-top: 1px solid var(--line);
  }

  .lessons a {
    font-size: var(--step-1);
    font-weight: 600;
    text-decoration: none;
  }

  .lessons a:hover {
    text-decoration: underline;
  }

  .description {
    margin-top: var(--space-1);
    color: var(--text-soft);
  }

  .lessons .meta + a {
    display: inline-block;
    margin-top: var(--space-1);
  }

  .lessons p.meta:last-child {
    margin-top: var(--space-2);
  }
</style>
