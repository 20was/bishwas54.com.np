---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { readingMinutes } from '../../lib/reading-time';

const tutorials = (
  await getCollection(
    'tutorials',
    ({ data }) => !data.draft || import.meta.env.DEV,
  )
).sort(
  (a, b) => b.data.datePublished.getTime() - a.data.datePublished.getTime(),
);

const seriesGroups = new Map<string, typeof tutorials>();
for (const t of tutorials) {
  const name = t.data.series?.name;
  if (name) seriesGroups.set(name, [...(seriesGroups.get(name) ?? []), t]);
}
for (const [name, group] of seriesGroups) {
  seriesGroups.set(
    name,
    group.sort(
      (a, b) => (a.data.series?.order ?? 0) - (b.data.series?.order ?? 0),
    ),
  );
}
const standalone = tutorials.filter((t) => !t.data.series);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
---

<Base
  title="Tutorials — Bishwas Adhikari"
  description="Beginner-friendly tutorials, each ending with a short practice quiz."
>
  <div class="listing">
    <h1>Tutorials</h1>
    <p class="lede">
      Longer lessons, written for beginners. Every one ends with a short quiz so
      you can check what stuck.
    </p>
    {
      tutorials.length === 0 && (
        <p class="empty">
          Nothing here yet — the first tutorials are being written. Check back
          soon.
        </p>
      )
    }
    {
      [...seriesGroups.entries()].map(([name, group]) => (
        <section class="series" aria-label={`Series: ${name}`}>
          <h2 class="meta series-title">
            Series · {name} — {group.length} part{group.length > 1 ? 's' : ''}
          </h2>
          <ul class="posts">
            {group.map((t) => (
              <li>
                <p class="meta">Part {t.data.series?.order}</p>
                <a href={`/tutorials/${t.id}/`}>{t.data.title}</a>
                <p class="description">{t.data.description}</p>
                <p class="meta">
                  <time
                    datetime={t.data.datePublished.toISOString().slice(0, 10)}
                  >
                    {fmt(t.data.datePublished)}
                  </time>
                  {' · '}
                  {readingMinutes(t.body ?? '')} min · {t.data.level}
                </p>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
    {
      standalone.length > 0 && (
        <ul class="posts">
          {standalone.map((t) => (
            <li>
              <a href={`/tutorials/${t.id}/`}>{t.data.title}</a>
              <p class="description">{t.data.description}</p>
              <p class="meta">
                <time
                  datetime={t.data.datePublished.toISOString().slice(0, 10)}
                >
                  {fmt(t.data.datePublished)}
                </time>
                {' · '}
                {readingMinutes(t.body ?? '')} min · {t.data.level}
              </p>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Base>

<style>
  .listing {
    max-width: var(--measure);
  }

  h1 {
    font-size: var(--step-3);
  }

  .lede {
    margin-top: var(--space-3);
    font-size: var(--step-1);
    color: var(--text-soft);
    line-height: 1.5;
  }

  .empty {
    margin-top: var(--space-5);
    color: var(--text-soft);
  }

  .series {
    margin-top: var(--space-5);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: var(--space-4);
  }

  .series-title {
    color: var(--accent);
  }

  .series .posts {
    margin-top: var(--space-3);
  }

  .posts {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
  }

  .posts li + li {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }

  .posts a {
    font-size: var(--step-1);
    font-weight: 650;
    text-decoration: none;
  }

  .posts a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .description {
    margin-top: var(--space-1);
    color: var(--text-soft);
  }

  .posts .meta {
    margin-top: var(--space-2);
  }
</style>
