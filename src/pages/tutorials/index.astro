---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { readingMinutes } from '../../lib/reading-time';

const tutorials = (
  await getCollection('tutorials', ({ data }) => !data.draft)
).sort(
  (a, b) => b.data.datePublished.getTime() - a.data.datePublished.getTime(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
---

<Base
  title="Tutorials — Bishwas Adhikari"
  description="Beginner-friendly tutorials, each ending with a short practice quiz."
>
  <div class="listing">
    <h1>Tutorials</h1>
    <p class="lede">
      Longer lessons, written for beginners. Every one ends with a short quiz so
      you can check what stuck.
    </p>
    {
      tutorials.length === 0 ? (
        <p class="empty">
          Nothing here yet — the first tutorials are being written. Check back
          soon.
        </p>
      ) : (
        <ul class="posts">
          {tutorials.map((t) => (
            <li>
              <a href={`/tutorials/${t.id}/`}>{t.data.title}</a>
              <p class="description">{t.data.description}</p>
              <p class="meta">
                <time
                  datetime={t.data.datePublished.toISOString().slice(0, 10)}
                >
                  {fmt(t.data.datePublished)}
                </time>
                {' · '}
                {readingMinutes(t.body ?? '')} min · {t.data.level}
              </p>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Base>

<style>
  .listing {
    max-width: var(--measure);
  }

  h1 {
    font-size: var(--step-3);
  }

  .lede {
    margin-top: var(--space-3);
    font-size: var(--step-1);
    color: var(--text-soft);
    line-height: 1.5;
  }

  .empty {
    margin-top: var(--space-5);
    color: var(--text-soft);
  }

  .posts {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
  }

  .posts li + li {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }

  .posts a {
    font-size: var(--step-1);
    font-weight: 650;
    text-decoration: none;
  }

  .posts a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .description {
    margin-top: var(--space-1);
    color: var(--text-soft);
  }

  .posts .meta {
    margin-top: var(--space-2);
  }
</style>
