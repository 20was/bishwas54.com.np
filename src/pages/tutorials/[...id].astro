---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { readingMinutes } from '../../lib/reading-time';
import { relatedPosts } from '../../lib/related';
import { articleJsonLd, breadcrumbJsonLd } from '../../lib/jsonld';

export async function getStaticPaths() {
  const tutorials = await getCollection(
    'tutorials',
    ({ data }) => !data.draft || import.meta.env.DEV,
  );
  return tutorials.map((entry) => ({
    params: { id: entry.id },
    props: { entry, all: tutorials },
  }));
}

const { entry, all } = Astro.props;
const { Content, headings } = await render(entry);
const related = relatedPosts(
  { id: entry.id, tags: entry.data.tags },
  all.map((t) => ({ id: t.id, tags: t.data.tags, title: t.data.title })),
);
const minutes = readingMinutes(entry.body ?? '');

const twoYears = 1000 * 60 * 60 * 24 * 730;
const lastTouch = entry.data.dateUpdated ?? entry.data.datePublished;
const stale = Date.now() - lastTouch.getTime() > twoYears;

const series = entry.data.series;
const seriesEntries = series
  ? all
      .filter((t) => t.data.series?.name === series.name)
      .sort((a, b) => (a.data.series?.order ?? 0) - (b.data.series?.order ?? 0))
  : [];
const seriesIndex = seriesEntries.findIndex((t) => t.id === entry.id);
const prev = seriesIndex > 0 ? seriesEntries[seriesIndex - 1] : undefined;
const next =
  seriesIndex >= 0 && seriesIndex < seriesEntries.length - 1
    ? seriesEntries[seriesIndex + 1]
    : undefined;

const path = `/tutorials/${entry.id}/`;
const ogImage = `/og/tutorials/${entry.id}.png`;
const jsonLd = [
  articleJsonLd({
    title: entry.data.title,
    description: entry.data.description,
    path,
    datePublished: entry.data.datePublished,
    dateUpdated: entry.data.dateUpdated,
    tags: entry.data.tags,
    image: ogImage,
  }),
  breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Tutorials', path: '/tutorials/' },
    ...(series
      ? [{ name: series.name, path: `/tutorials/${entry.id.split('/')[0]}/` }]
      : []),
    { name: entry.data.title, path },
  ]),
];
---

<Article
  title={entry.data.title}
  description={entry.data.description}
  datePublished={entry.data.datePublished}
  dateUpdated={entry.data.dateUpdated}
  readingMinutes={minutes}
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  <Fragment slot="margin">
    <p class="meta level">{entry.data.level}</p>
    {
      series && (
        <p class="meta series-label">
          <a href={`/tutorials/${entry.id.split('/')[0]}/`}>{series.name}</a> ·
          part {series.order} of {seriesEntries.length}
        </p>
      )
    }
    <TableOfContents headings={headings} />
  </Fragment>

  {
    entry.data.archived && (
      <p class="banner meta">
        Archived — kept for reference, no longer maintained.
      </p>
    )
  }
  {
    !entry.data.archived && stale && (
      <p class="banner meta">
        Heads up: this hasn't been reviewed in over two years and may be
        outdated.
      </p>
    )
  }

  <Content />

  {
    (prev || next) && (
      <nav class="series-nav" aria-label="Series navigation">
        {prev ? (
          <a href={`/tutorials/${prev.id}/`} class="prev">
            <span class="meta">← Previous in series</span>
            <span>{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a href={`/tutorials/${next.id}/`} class="next">
            <span class="meta">Next in series →</span>
            <span>{next.data.title}</span>
          </a>
        )}
      </nav>
    )
  }

  {
    related.length > 0 && (
      <footer class="related">
        <h2>Keep learning</h2>
        <ul>
          {related.map((post) => (
            <li>
              <a href={`/tutorials/${post.id}/`}>{post.title}</a>
            </li>
          ))}
        </ul>
      </footer>
    )
  }
</Article>

<style>
  .banner {
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    padding: var(--space-2) var(--space-3);
    margin-bottom: var(--space-4);
  }

  .level {
    color: var(--accent);
  }

  .series-nav {
    margin-top: var(--space-5);
    border-top: 1px solid var(--line);
    padding-top: var(--space-4);
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .series-nav a {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    text-decoration: none;
    font-weight: 600;
    max-width: 45%;
  }

  .series-nav a:hover {
    color: var(--accent);
  }

  .series-nav .next {
    text-align: right;
    margin-left: auto;
  }

  .related {
    margin-top: var(--space-5);
    border-top: 1px solid var(--line);
    padding-top: var(--space-4);
  }

  .related h2 {
    font-size: var(--step-1);
  }

  .related ul {
    margin: var(--space-3) 0 0;
    padding-left: 1.4rem;
  }
</style>
