---
import ThemeSwitch from './ThemeSwitch.astro';

const nav = [
  ['Tutorials', '/tutorials/'],
  ['Notes', '/notes/'],
  ['About', '/about/'],
  ['Search', '/search/'],
] as const;

const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="inner">
    <a class="wordmark" href="/">Bishwas Adhikari</a>
    <nav aria-label="Site">
      <ul>
        {
          nav.map(([label, href]) => (
            <li>
              <a
                href={href}
                aria-current={current.startsWith(href) ? 'page' : undefined}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeSwitch />
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
  }

  .inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-3) var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .wordmark {
    font-family: var(--font-serif);
    font-weight: 650;
    font-size: var(--step-0);
    text-decoration: none;
    margin-right: auto;
  }

  .wordmark:hover {
    color: var(--accent);
  }

  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-4);
  }

  nav a {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    text-decoration: none;
    color: var(--text-soft);
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--accent);
  }

  nav a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 0.4em;
    text-decoration-color: var(--accent);
  }

  @media (max-width: 540px) {
    .inner {
      gap: var(--space-3);
    }
    nav ul {
      gap: var(--space-3);
    }
  }
</style>
