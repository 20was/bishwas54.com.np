{
  /* Compact theme picker: one swatch per theme, radio semantics for
     keyboard + screen readers. Auto = half light / half dark dot. */
}
<theme-switch>
  <fieldset>
    <legend class="visually-hidden">Color theme</legend>
    {
      [
        ['auto', 'Match system theme'],
        ['light', 'Light theme'],
        ['sepia', 'Sepia theme'],
        ['dark', 'Dark theme'],
      ].map(([value, label], i) => (
        <label title={label} class={value}>
          <input
            type="radio"
            name="theme"
            value={value}
            checked={i === 0}
            class="visually-hidden"
          />
          <span class="swatch" aria-hidden="true" />
          <span class="visually-hidden">{label}</span>
        </label>
      ))
    }
  </fieldset>
</theme-switch>

<script>
  class ThemeSwitch extends HTMLElement {
    connectedCallback() {
      const stored = localStorage.getItem('theme');
      const current =
        stored === 'light' || stored === 'sepia' || stored === 'dark'
          ? stored
          : 'auto';
      const input = this.querySelector<HTMLInputElement>(
        `input[value="${current}"]`,
      );
      if (input) input.checked = true;

      this.addEventListener('change', (e) => {
        const value = (e.target as HTMLInputElement).value;
        if (value === 'auto') {
          localStorage.removeItem('theme');
          ThemeSwitch.applyTheme(
            matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light',
          );
        } else {
          localStorage.setItem('theme', value);
          ThemeSwitch.applyTheme(value);
        }
      });

      matchMedia('(prefers-color-scheme: dark)').addEventListener(
        'change',
        (e) => {
          if (!localStorage.getItem('theme')) {
            ThemeSwitch.applyTheme(e.matches ? 'dark' : 'light');
          }
        },
      );
    }

    static applyTheme(theme: string) {
      document.documentElement.dataset.theme = theme;
      const themeColor = {
        light: '#faf9f5',
        sepia: '#f6ecd9',
        dark: '#151619',
      }[theme];
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute('content', themeColor ?? '#faf9f5');
    }
  }
  customElements.define('theme-switch', ThemeSwitch);
</script>

<style>
  fieldset {
    border: none;
    padding: 0;
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  label {
    cursor: pointer;
    display: inline-flex;
    padding: 2px;
    border-radius: 50%;
  }

  .swatch {
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    transition:
      transform 120ms ease,
      box-shadow 120ms ease;
  }

  label.light .swatch {
    background: #faf9f5;
  }

  label.sepia .swatch {
    background: #f6ecd9;
  }

  label.dark .swatch {
    background: #151619;
  }

  label.auto .swatch {
    background: linear-gradient(135deg, #faf9f5 50%, #151619 50%);
  }

  label:hover .swatch {
    transform: scale(1.18);
  }

  label:has(input:checked) .swatch {
    box-shadow:
      0 0 0 2px var(--bg),
      0 0 0 4px var(--accent);
  }

  label:has(input:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
</style>
