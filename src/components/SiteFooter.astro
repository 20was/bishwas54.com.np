---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="inner">
    <p>© {year} Bishwas Adhikari. Written to learn; shared to help.</p>
    <p>
      <a href="/rss.xml">RSS</a> ·
      <a href="/archive/">Archive</a> ·
      <a href="https://github.com/20was/bishwas54.com.np">Source on GitHub</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: var(--space-6);
  }

  .inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-4);
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--text-soft);
  }
</style>
