---
interface Props {
  question: string;
  options: string[];
  /** Zero-based index of the correct option */
  answer: number;
}

const { question, options, answer } = Astro.props;
const uid = `q-${Math.random().toString(36).slice(2, 8)}`;
---

<quiz-question data-answer={answer}>
  <fieldset>
    <legend>{question}</legend>
    {
      options.map((option, i) => (
        <label data-index={i}>
          <input type="radio" name={uid} value={i} />
          <span>{option}</span>
        </label>
      ))
    }
  </fieldset>
  <p class="feedback" role="status"></p>
  <details class="explanation">
    <summary>Explanation</summary>
    <div><slot /></div>
  </details>
</quiz-question>

<script>
  class QuizQuestion extends HTMLElement {
    connectedCallback() {
      this.addEventListener('change', (e) => {
        const input = e.target as HTMLInputElement;
        const chosen = Number(input.value);
        const answer = Number(this.dataset.answer);
        const correct = chosen === answer;

        this.querySelectorAll('label').forEach((label) => {
          const i = Number(label.dataset.index);
          label.classList.toggle('correct', i === answer);
          label.classList.toggle('incorrect', i === chosen && !correct);
        });
        this.querySelectorAll('input').forEach((r) => (r.disabled = true));

        const feedback = this.querySelector<HTMLElement>('.feedback');
        if (feedback) {
          feedback.textContent = correct
            ? 'Correct!'
            : `Not quite — the answer is "${
                this.querySelectorAll('label span')[answer]?.textContent ?? ''
              }".`;
          feedback.classList.add(correct ? 'is-correct' : 'is-incorrect');
        }
        this.querySelector('details')?.setAttribute('open', '');
        this.dispatchEvent(
          new CustomEvent('quiz-answered', {
            bubbles: true,
            detail: { correct },
          }),
        );
      });
    }
  }
  customElements.define('quiz-question', QuizQuestion);
</script>

<style>
  quiz-question {
    display: block;
  }

  fieldset {
    border: none;
    padding: 0;
    margin: 0;
  }

  legend {
    font-weight: 650;
    margin-bottom: var(--space-2);
    padding: 0;
  }

  label {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--line);
    border-radius: 6px;
    margin-top: var(--space-2);
    cursor: pointer;
    font-size: var(--step--1);
    line-height: 1.5;
  }

  label:hover {
    border-color: var(--line-strong);
  }

  label.correct {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  label.incorrect {
    border-color: var(--line-strong);
    background: var(--bg-raised);
    text-decoration: line-through;
  }

  label:has(input:disabled) {
    cursor: default;
  }

  .feedback {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 600;
    margin-top: var(--space-2);
    min-height: 1.2em;
  }

  .feedback.is-correct {
    color: var(--accent);
  }

  .feedback.is-incorrect {
    color: var(--text-soft);
  }

  .explanation {
    margin-top: var(--space-2);
    font-size: var(--step--1);
    color: var(--text-soft);
  }

  .explanation summary {
    cursor: pointer;
    font-family: var(--font-sans);
  }

  .explanation div {
    margin-top: var(--space-2);
  }
</style>
