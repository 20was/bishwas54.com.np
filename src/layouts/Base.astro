---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { webSiteJsonLd } from '../lib/jsonld';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: string | undefined;
  /** Extra JSON-LD blocks (Article, BreadcrumbList, ProfilePage…) */
  jsonLd?: object[];
}

const {
  title,
  description,
  noindex = false,
  ogType = 'website',
  ogImage = '/og/default.png',
  jsonLd = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const blocks = [webSiteJsonLd(), ...jsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#faf9f5" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Bishwas Adhikari" />
    <meta name="twitter:card" content="summary_large_image" />

    <link
      rel="alternate"
      type="application/rss+xml"
      title="Bishwas Adhikari"
      href={new URL('rss.xml', Astro.site)}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {
      blocks.map((block) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(block)}
          is:inline
        />
      ))
    }

    <link
      rel="preload"
      href="/fonts/literata-roman.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const theme =
          stored === 'light' || stored === 'sepia' || stored === 'dark'
            ? stored
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.dataset.theme = theme;
        const colors = { light: '#faf9f5', sepia: '#f6ecd9', dark: '#151619' };
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', colors[theme]);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  main {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-5) var(--space-4);
  }

  /* Non-article pages: fill the same container the nav spans, so every
     page's content starts and ends on the same lines as the header. */
  main > :global(.listing),
  main > :global(.home),
  main > :global(.guide),
  main > :global(.archive),
  main > :global(.search-page),
  main > :global(.lost) {
    max-width: none;
  }
</style>
