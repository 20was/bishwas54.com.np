---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  datePublished?: Date | undefined;
  dateUpdated?: Date | undefined;
  readingMinutes?: number | undefined;
  noindex?: boolean;
  ogImage?: string | undefined;
  jsonLd?: object[];
}

const {
  title,
  description,
  datePublished,
  dateUpdated,
  readingMinutes,
  noindex = false,
  ogImage,
  jsonLd = [],
} = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
---

<Base
  title={title}
  description={description}
  noindex={noindex}
  ogType="article"
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  <article class="article">
    {
      /* The notebook margin: metadata lives beside the prose on wide screens,
        folds above it on narrow ones. */
    }
    <div class="margin">
      <div class="margin-inner">
        {
          datePublished && (
            <p class="meta">
              <time datetime={datePublished.toISOString().slice(0, 10)}>
                {fmt(datePublished)}
              </time>
            </p>
          )
        }
        {
          dateUpdated && (
            <p class="meta updated">
              Updated{' '}
              <time datetime={dateUpdated.toISOString().slice(0, 10)}>
                {fmt(dateUpdated)}
              </time>
            </p>
          )
        }
        {readingMinutes && <p class="meta">{readingMinutes} min read</p>}
        <slot name="margin" />
      </div>
    </div>
    <div class="body">
      <header>
        <h1>{title}</h1>
        <p class="lede">{description}</p>
      </header>
      <div class="prose" data-pagefind-body={noindex ? undefined : true}>
        <slot />
      </div>
    </div>
  </article>
</Base>

<style>
  .article {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .margin-inner {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    align-items: baseline;
  }

  .article h1 {
    font-size: var(--step-3);
    font-weight: 700;
    max-width: var(--measure);
  }

  .lede {
    margin-top: var(--space-3);
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--text-soft);
    max-width: var(--measure);
    text-wrap: pretty;
  }

  .body > header {
    margin-bottom: var(--space-5);
  }

  .meta.updated {
    color: var(--accent);
  }

  /* Wide screens: margin rail at the container's left edge (aligned with
     the nav wordmark), prose beside it ending at the container's right
     edge (aligned with the nav links). */
  @media (min-width: 1100px) {
    .article {
      flex-direction: row;
      align-items: stretch;
      gap: var(--margin-gap);
    }

    .margin {
      flex: 0 0 var(--margin-col);
      border-right: 1px solid var(--line);
      padding-right: var(--margin-gap);
    }

    .body {
      flex: 1;
      min-width: 0;
      max-width: var(--measure);
    }

    .margin-inner {
      position: sticky;
      top: var(--space-4);
      flex-direction: column;
      gap: var(--space-2);
    }
  }
</style>
